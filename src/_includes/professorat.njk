{#- El nostre centre › Professorat: marcatge comú (ca/es/en).
    Dades: src/_data/professorat.json · Estils: src/assets/css/professorat.css -#}
{%- set L = lang | default('ca') -%}
{%- set d = professorat -%}
<div class="prof-page">

<div class="qs-hero" id="qsHero">
  <img src="/assets/img/inici/inici-1-facana-2400.jpg" srcset="/assets/img/inici/inici-1-facana-1600.jpg 1600w, /assets/img/inici/inici-1-facana-2400.jpg 2400w" sizes="100vw" width="2400" height="900" fetchpriority="high" alt="" role="presentation">
  <div class="qs-hero__box">
    <h1><span class="qs-hero__title">{{ d.textos.heroTitol[L] }}</span><span class="qs-hero__subtitle">{{ d.textos.heroSubtitol[L] }}</span></h1>
  </div>
</div>

<div class="prof-wrap">
  <div class="prof-intro">
    <h2 class="prof-kicker">{{ d.textos.kicker[L] }}</h2>
    <p class="prof-lead">{{ d.textos.lead[L] }}</p>
  </div>

  <div class="prof-tools">
    <label class="prof-search">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <span class="prof-sr">{{ d.textos.cerca[L] }}</span>
      <input type="search" id="profSearch" placeholder="{{ d.textos.cerca[L] }}" autocomplete="off">
    </label>
    <p class="prof-count" aria-live="polite"><strong id="profCount">{{ d.persones | length }}</strong> {{ d.textos.total[L] }}</p>
  </div>

  <table class="prof-table">
    <thead>
      <tr><th scope="col">{{ d.textos.nom[L] }}</th><th scope="col">{{ d.textos.especialitat[L] }}</th><th scope="col">{{ d.textos.email[L] }}</th></tr>
    </thead>
    <tbody id="profBody">
      {%- for p in d.persones %}
      <tr>
        <th scope="row" class="prof-name">{{ p.nom }}</th>
        <td class="prof-esp">{{ p.especialitat[L] }}</td>
        <td class="prof-mail">{% if p.email %}<a href="mailto:{{ p.email }}">{{ p.email }}</a>{% else %}<span aria-hidden="true">—</span>{% endif %}</td>
      </tr>
      {%- endfor %}
    </tbody>
  </table>
  <p class="prof-empty" id="profEmpty" hidden>{{ d.textos.cap[L] }}</p>
</div>

</div>

<script>
  // Professorat: la llista es llegeix de GESTIO › Professorat (PAS 56; la del build és la reserva) i es filtra per nom o
  // especialitat (sense accents ni majúscules)
  (function(){
    var input = document.getElementById('profSearch'), body = document.getElementById('profBody');
    if (!input || !body) return;
    var L = {{ L | dump | safe }}, ESP = {{ d.especialitats | dump | safe }};
    var count = document.getElementById('profCount'), empty = document.getElementById('profEmpty');
    var rows = [], texts = [];
    function norm(s){ return s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase(); }
    function esc(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function indexa(){
      rows = Array.prototype.slice.call(body.querySelectorAll('tr'));
      texts = rows.map(function(r){ return norm(r.querySelector('.prof-name').textContent + ' ' + r.querySelector('.prof-esp').textContent); });
    }
    function filtra(){
      var q = norm(input.value.trim()), n = 0;
      rows.forEach(function(r, i){ var on = !q || texts[i].indexOf(q) !== -1; r.hidden = !on; if (on) n++; });
      count.textContent = n;
      empty.hidden = n !== 0;
    }
    indexa();
    input.addEventListener('input', filtra);
    fetch('/api/gestio-publics?quin=professorat').then(function(r){ return r.json(); }).then(function(d){
      if (!d || !d.ok || !d.persones || !d.persones.length) return;
      body.innerHTML = d.persones.map(function(p){
        var e = ESP[p.especialitat] || Object.keys(ESP).map(function(k){ return ESP[k]; }).filter(function(x){ return x.ca === p.especialitat; })[0], esp = e ? e[L] : p.especialitat;
        return '<tr><th scope="row" class="prof-name">' + esc(p.nom) + '</th><td class="prof-esp">' + esc(esp || '') + '</td><td class="prof-mail">' +
          (p.email ? '<a href="mailto:' + esc(p.email) + '">' + esc(p.email) + '</a>' : '<span aria-hidden="true">—</span>') + '</td></tr>';
      }).join('');
      indexa(); filtra();
    }).catch(function(){ /* sense connexió amb GESTIO: es manté la llista del build */ });
  })();
</script>
