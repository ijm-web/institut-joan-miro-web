{#- Estudis › ESO: marcatge comú de la pàgina (ca/es/en).
    Cada pàgina (src/eso.njk, src/es/eso.njk, src/en/eso.njk) defineix `lang`.
    Les dades són a src/_data/eso.json; els estils a src/assets/css/eso.css.
    Les dades pendents porten la classe `tbd` (fons groc). -#}
{%- set L = lang | default('ca') -%}
{%- set P = '' -%}
{%- if L == 'es' -%}{%- set P = 'es/' -%}{%- elif L == 'en' -%}{%- set P = 'en/' -%}{%- endif -%}
{%- set e = eso -%}
<div class="eso-page">

<div class="qs-hero" id="qsHero">
  <img src="/assets/img/inici/inici-2-passadis-2400.jpg" srcset="/assets/img/inici/inici-2-passadis-1600.jpg 1600w, /assets/img/inici/inici-2-passadis-2400.jpg 2400w" sizes="100vw" width="2400" height="900" fetchpriority="high" alt="" role="presentation">
  <div class="qs-hero__box">
    <h1><span class="qs-hero__title">{{ e.heroTitol[L] }}</span><span class="qs-hero__subtitle">{{ e.heroSubtitol[L] }}</span></h1>
  </div>
</div>

<p class="eso-pending-note">{{ e.pendent[L] | safe }}</p>

<!-- ============ INTRODUCCIÓ ============ -->
<div class="eso-wrap">
  <div class="eso-intro">
    <h2 class="eso-kicker">{{ e.kicker[L] }}</h2>
    <p class="eso-lead">{{ e.lead[L] | safe }}</p>
  </div>
  <ul class="eso-stats">
    {%- for s in e.stats %}
    <li><span class="eso-stats__num">{{ s.num }}</span><span class="eso-stats__label">{{ s.label[L] }}</span></li>
    {%- endfor %}
  </ul>
  <nav class="eso-anchors" aria-label="{{ e.heroSubtitol[L] }}">
    {%- for a in e.anchors %}
    <a href="#{{ a.id }}">{{ a.label[L] }}</a>
    {%- endfor %}
  </nav>
</div>

<!-- ============ ORGANITZACIÓ I HORARI ============ -->
<section id="organitzacio" class="eso-band">
  <div class="eso-wrap">
    <h2 class="eso-ttl">{{ e.org.titol[L] }}</h2>
    <div class="eso-row">
      <h3 class="eso-row__head">{{ e.org.comTitol[L] }}</h3>
      <div class="eso-row__body">
        <p>{{ e.org.com1[L] | safe }}</p>
        <p>{{ e.org.com2[L] | safe }}</p>
      </div>
    </div>
    <div class="eso-row">
      <h3 class="eso-row__head">{{ e.org.horariTitol[L] }}</h3>
      <div class="eso-row__body">
        <p>{{ e.org.horariText[L] }}</p>
        <div class="eso-sched" aria-hidden="true">
          <div></div>
          {%- for d in e.org.dies[L] %}<div class="eso-sched__day">{{ d }}</div>{% endfor %}
          <div class="eso-sched__time">8.15–11.15</div>
          {%- for d in e.org.dies[L] %}<div class="eso-sched__cell">{{ e.org.classes[L] }}</div>{% endfor %}
          <div class="eso-sched__time eso-sched__time--break">11.15–11.45</div>
          {%- for d in e.org.dies[L] %}<div class="eso-sched__break">{{ e.org.esbarjo[L] }}</div>{% endfor %}
          <div class="eso-sched__time">11.45–14.45</div>
          {%- for d in e.org.dies[L] %}<div class="eso-sched__cell">{{ e.org.classes[L] }}</div>{% endfor %}
        </div>
      </div>
    </div>
    <div class="eso-row">
      <h3 class="eso-row__head">{{ e.org.mobilsTitol[L] }}</h3>
      <div class="eso-row__body">
        <p class="eso-nophone"><svg aria-hidden="true" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#E8600C" stroke-width="1.6" stroke-linecap="round"><rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M11 18.5h2"/><path d="M3 3l18 18"/></svg><span>{{ e.org.mobilsText[L] }}</span></p>
      </div>
    </div>
    <div class="eso-row">
      <h3 class="eso-row__head">{{ e.org.llenguesTitol[L] }}</h3>
      <div class="eso-row__body">
        <p>{{ e.org.llenguesText[L] }}</p>
        <ul class="eso-chips">
          {%- for l in e.org.llengues[L] %}<li>{{ l }}</li>{% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ============ ARRIBAR A 1r D'ESO ============ -->
<section id="arribar">
  <div class="eso-wrap">
    <h2 class="eso-ttl">{{ e.arribar.titol[L] }}</h2>
    <p class="eso-sub">{{ e.arribar.text[L] }}</p>
    <ol class="eso-steps">
      {%- for p in e.arribar.passos %}
      <li>
        <span class="eso-steps__num" aria-hidden="true">{{ loop.index }}</span>
        <span class="eso-steps__when">{{ p.quan[L] }}</span>
        <h3>{{ p.titol[L] }}</h3>
        <p>{{ p.text[L] }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<!-- ============ CURRÍCULUM PER CURS ============ -->
<section id="curriculum" class="eso-band">
  <div class="eso-wrap">
    <h2 class="eso-ttl">{{ e.curr.titol[L] }}</h2>
    <p class="eso-sub">{{ e.curr.sub[L] }}</p>
    <div class="eso-tabs" role="tablist" aria-label="{{ e.curr.tabsLabel[L] }}">
      {%- for c in e.curr.cursos %}
      <button type="button" role="tab" id="eso-tab-{{ loop.index }}" aria-controls="eso-panel-{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ c.label[L] }}</button>
      {%- endfor %}
    </div>
    {%- for c in e.curr.cursos %}
    <div class="eso-panel" role="tabpanel" id="eso-panel-{{ loop.index }}" aria-labelledby="eso-tab-{{ loop.index }}"{% if not loop.first %} hidden{% endif %}>
      <div class="eso-common">
        <div class="eso-common__head">
          <h3>{{ e.curr.comunes[L] }} · {{ c.label[L] }}</h3>
          <span>{{ e.curr.hores[L] }}</span>
        </div>
        <ul class="eso-subjects">
          {%- for m in c.comunes %}
          <li><span{% if c.comunesPendent %} class="tbd"{% endif %}>{{ m[L] }}{% if m.nota %} <small class="eso-subjects__note">({{ m.nota[L] }})</small>{% endif %}</span>{% if m.h %}<span class="eso-subjects__h">{{ m.h }} h</span>{% else %}<span class="tbd">[h]</span>{% endif %}</li>
          {%- endfor %}
        </ul>
      </div>
      <div class="eso-side">
        <div class="eso-opts">
          <h3>{{ e.curr.optatives[L] }} · {{ c.label[L] }}</h3>
          <p>{{ c.optText[L] | safe }}</p>
          <ul>
            {%- for o in c.opts %}<li{% if o.pendent %} class="tbd"{% endif %}>{{ o.n[L] }}</li>{% endfor %}
          </ul>
        </div>
        {%- if c.destacat %}
        <div class="eso-pool">
          <span class="eso-pool__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 16c1.5 0 2.5-1 4-1s2.5 1 4 1 2.5-1 4-1 2.5 1 4 1 2.5-1 4-1"/><path d="M2 20c1.5 0 2.5-1 4-1s2.5 1 4 1 2.5-1 4-1 2.5 1 4 1 2.5-1 4-1"/><path d="M8 13V5a2 2 0 0 1 4 0M16 13V5a2 2 0 0 0-4 0M8 8h8M8 11h8"/></svg></span>
          <div class="eso-pool__body">
            <h3>{{ c.destacat.titol[L] }}</h3>
            <p>{{ c.destacat.text[L] }}</p>
            <a href="/{{ P }}{{ c.destacat.href }}">{{ c.destacat.enllac[L] }} <span aria-hidden="true">→</span></a>
          </div>
        </div>
        {%- endif %}
        <a class="eso-doc eso-doc--row" href="#" target="_blank" rel="noopener">
          <span>{{ e.curr.pdfOpt[L] }} {{ c.label[L] }} <span class="tbd">{{ e.curr.pdfPendent[L] }}</span></span>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M9 7h8v8"/></svg>
        </a>
      </div>
    </div>
    {%- endfor %}
  </div>
</section>

<!-- ============ CRITERIS DE QUALIFICACIÓ ============ -->
<section id="qualificacio">
  <div class="eso-wrap">
    <h2 class="eso-ttl">{{ e.qual.titol[L] }}</h2>
    <div class="eso-row">
      <h3 class="eso-row__head">{{ e.qual.comTitol[L] }}</h3>
      <div class="eso-row__body">
        <p>{{ e.qual.comText[L] }}</p>
        <div class="eso-docs">
          {%- for c in e.curr.cursos %}
          <a class="eso-doc" href="#" target="_blank" rel="noopener"><span class="eso-doc__title">{{ c.label[L] }}</span><span class="eso-doc__meta tbd">{{ e.curr.pdfPendent[L] | replace('(', '') | replace(')', '') }}</span></a>
          {%- endfor %}
        </div>
        <p>{{ e.qual.butlletinsText[L] }}</p>
        <ol class="eso-reports">
          {%- for b in e.qual.butlletins %}
          <li{% if b.paper %} class="eso-reports__item--paper"{% endif %}><span class="eso-reports__when">{{ b.quan[L] }}</span><span class="eso-reports__what">{{ b.que[L] }}</span><span class="eso-reports__fmt">{{ b.format[L] }}</span></li>
          {%- endfor %}
        </ol>
      </div>
    </div>
    <div class="eso-row">
      <h3 class="eso-row__head">{{ e.qual.promoTitol[L] }}</h3>
      <div class="eso-row__body">
        <p>{{ e.qual.promoText[L] | safe }}</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ PROJECTES ============ -->
<section id="projectes" class="eso-band">
  <div class="eso-wrap">
    <h2 class="eso-ttl">{{ e.proj.titol[L] }}</h2>
    <ul class="eso-cards">
      {%- for p in e.proj.items %}
      <li>
        {%- if p.href %}<a class="eso-card" href="/{{ P }}{{ p.href }}">{% else %}<div class="eso-card">{% endif %}
          <div class="eso-card__img">{{ e.proj.foto[L] }}</div>
          <div class="eso-card__body">
            <span class="eso-card__tag">{{ p.tag[L] }}</span>
            <h3>{{ p.titol[L] }}</h3>
            <p>{{ p.text[L] | safe }}</p>
          </div>
        {% if p.href %}</a>{% else %}</div>{% endif %}
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<!-- ============ ORIENTACIÓ ============ -->
<section id="orientacio">
  <div class="eso-wrap">
    <h2 class="eso-ttl">{{ e.ori.titol[L] }}</h2>
    <div class="eso-cols">
      <div>
        <svg aria-hidden="true" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#E8600C" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
        <h3>{{ e.ori.tutoriaTitol[L] }}</h3>
        <p>{{ e.ori.tutoriaText[L] | safe }}</p>
      </div>
      <div>
        <svg aria-hidden="true" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#E8600C" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/></svg>
        <h3>{{ e.ori.acadTitol[L] }}</h3>
        <p>{{ e.ori.acadText[L] | safe }}</p>
      </div>
      <div>
        <svg aria-hidden="true" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#E8600C" stroke-width="1.6"><path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z"/></svg>
        <h3>{{ e.ori.divTitol[L] }}</h3>
        <p>{{ e.ori.divText[L] | safe }}</p>
        <ul class="eso-list">
          {%- for x in e.ori.divList %}<li>{{ x[L] }}</li>{% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ============ INFORMACIÓ PRÀCTICA ============ -->
<section id="practica" class="eso-band">
  <div class="eso-wrap">
    <h2 class="eso-ttl">{{ e.prac.titol[L] }}</h2>
    <div class="eso-docs eso-docs--wide">
      <a class="eso-doc" href="#" target="_blank" rel="noopener">
        <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#E8600C" stroke-width="1.6"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19V5"/></svg>
        <span class="eso-doc__title">{{ e.prac.llibres[L] }}</span>
        <span class="eso-doc__meta">{{ e.prac.llibresMeta[L] | safe }}</span>
      </a>
      <a class="eso-doc" href="/{{ P }}calendari-escolar.html">
        <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#E8600C" stroke-width="1.6"><rect x="3" y="5" width="18" height="16" rx="1"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
        <span class="eso-doc__title">{{ e.prac.calendari[L] }}</span>
        <span class="eso-doc__meta">{{ e.prac.calendariMeta[L] | safe }}</span>
      </a>
      <a class="eso-doc" href="/{{ P }}secretaria-preinscripcio-matricula.html">
        <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#E8600C" stroke-width="1.6"><path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg>
        <span class="eso-doc__title">{{ e.prac.preins[L] }}</span>
        <span class="eso-doc__meta">{{ e.prac.preinsMeta[L] }}</span>
      </a>
    </div>
  </div>
</section>

<!-- ============ FRANJA FINAL ============ -->
<section class="eso-cta">
  <div class="eso-cta__inner">
    <div>
      <p class="eso-cta__title">{{ e.cta.titol[L] }}</p>
      <p class="eso-cta__text">{{ e.cta.text[L] }}</p>
    </div>
    <a href="/{{ P }}contacte.html">{{ e.cta.boto[L] }}</a>
  </div>
</section>

</div>

{% raw %}
<script>
  // ============ ESO: pestanyes del currículum per curs ============
  (function(){
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.eso-tabs [role="tab"]'));
    if (!tabs.length) return;
    function select(tab){
      tabs.forEach(function(t){
        var on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        var panel = document.getElementById(t.getAttribute('aria-controls'));
        if (panel) panel.hidden = !on;
      });
    }
    tabs.forEach(function(t, i){
      t.addEventListener('click', function(){ select(t); });
      t.addEventListener('keydown', function(ev){
        var n = null;
        if (ev.key === 'ArrowRight') n = tabs[(i + 1) % tabs.length];
        else if (ev.key === 'ArrowLeft') n = tabs[(i - 1 + tabs.length) % tabs.length];
        else if (ev.key === 'Home') n = tabs[0];
        else if (ev.key === 'End') n = tabs[tabs.length - 1];
        if (n){ ev.preventDefault(); select(n); n.focus(); }
      });
    });
  })();
</script>
{% endraw %}
