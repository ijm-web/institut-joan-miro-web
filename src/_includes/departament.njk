{#- PAS 75/76 · Pàgina d'un departament/àmbit, el mateix format per a tots (disseny com Projectes › Llengües estrangeres).
    Ordre: presentació (amb imatge), professorat, programacions, criteris de qualificació, matèries i professorat, projectes,
    feines d'estiu i altres. Un apartat buit no surt. L'HTML el fa src/assets/js/departament-pagina.js (el mateix codi que la
    «Vista prèvia» de GESTIO). Del professorat, només el nom complet; cap dada d'alumnat. -#}
{%- set L = departaments.text[lang] or departaments.text.ca %}
{%- set H = dep.html[lang] or dep.html.ca %}
{{ H.hero | safe }}
{{ H.cos | safe }}
{% include "departaments-reveal.njk" %}
{%- if dep.criteris.length %}
<script src="/assets/js/criteris-pdf.js" defer></script>
<script>window.DEP_TXT = {{ L.js | dump | safe }};</script>
{% raw %}
<script>
  // Criteris de qualificació del departament: /api/criteris-publics del nivell, només les matèries del departament → PDF
  document.addEventListener('DOMContentLoaded', function(){
    var plega = function(t){ return String(t || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/\s*\(.*?\)\s*/g, ' ').replace(/[^a-z0-9]+/g, ' ').trim(); };
    var data = function(d){ var m = String(d || '').match(/^(\d{4})-(\d{2})-(\d{2})/); return m ? Number(m[3]) + '/' + Number(m[2]) + '/' + m[1] : ''; };
    var dep = (document.querySelector('.dp-hero .qs-hero__subtitle') || {}).textContent || '';
    Array.prototype.forEach.call(document.querySelectorAll('[data-criteris-dep]'), function(a){
      a.addEventListener('click', function(ev){
        ev.preventDefault();
        var nivell = a.getAttribute('data-criteris-dep'), nom = a.getAttribute('data-nom'), noms = JSON.parse(a.getAttribute('data-materies') || '[]').map(plega);
        var w = window.open('', '_blank'), avis = function(t){ if (w && !w.closed) w.document.body.innerHTML = '<p style="font:16px/1.6 Montserrat,system-ui,sans-serif;max-width:560px;margin:15vh auto;padding:0 16px;text-align:center">' + t + '</p>'; };
        var T = window.DEP_TXT || {}; avis(T.generant);
        Promise.all([fetch('/api/criteris-publics?nivell=' + encodeURIComponent(nivell)).then(function(r){ return r.json(); }), CriterisPdf.prepara()]).then(function(x){
          var d = x[0], R = x[1]; if (!d || !d.ok) throw new Error((d && d.error) || 'error');
          var del = function(m){ var p = plega(m.materia); return noms.some(function(n){ return n && (p === n || p.indexOf(n) >= 0 || n.indexOf(p) >= 0); }); };
          var mats = d.materies.filter(del).filter(function(m){ var i = m.info || {}; return m.criteris.length || m.competencies.length || i.criteri_aprovar || i.recuperacio || i.millora; });
          if (!mats.length) return avis(T.senseCriteris + ' ' + nom + '.');
          var doc = CriterisPdf.genera(R, { curs: d.curs, lang: 'ca', capcalera: 'Criteris de qualificació',
            portada: { titol: 'Criteris de qualificació', subtitol: dep + ' · ' + nom + ' · Curs ' + d.curs, head: [['Matèria', 'Actualització']], body: mats.map(function(m){ return [m.materia, data((m.info || {}).data) || '—']; }), columnStyles: { 1: { cellWidth: 34 } } },
            competenciesDigitals: d.competencies_digitals, assoliment: !/^BAT/.test(nivell),
            materies: mats.map(function(m){ return { titol: m.materia, pagina: nom + ' · ' + m.materia, subtitol: nom, senseCD: /^BAT/.test(nivell), sensePendents: /^(ESO 4t|BAT 2n)$/.test(nivell), criteris: m.criteris, competencies: m.competencies, info: m.info || {} }; }) });
          var fitxer = 'criteris-qualificacio-' + nivell.toLowerCase().replace(/\s+/g, '-') + '-' + d.curs + '.pdf';
          if (w && !w.closed) w.location.href = doc.output('bloburl', { filename: fitxer }); else doc.save(fitxer);
        }).catch(function(){ avis(T.error); });
      });
    });
  });
</script>
{% endraw %}
{%- endif %}
