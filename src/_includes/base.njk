<script>

  (function(){
    var siteHeader = document.getElementById('siteHeader');
    var topbar = document.getElementById('topbar');
    var lastY = window.scrollY;
    var ticking = false;
    var threshold = 12;

    function onScroll(){
      var currentY = window.scrollY;
      if (currentY > 40 && currentY > lastY + threshold) {
        topbar.classList.add('is-collapsed');
      } else if (currentY < lastY - threshold || currentY <= 40) {
        topbar.classList.remove('is-collapsed');
      }
      if (currentY > 4) {
        siteHeader.classList.add('has-shadow');
      } else {
        siteHeader.classList.remove('has-shadow');
      }
      lastY = currentY;
      ticking = false;
    }

    window.addEventListener('scroll', function(){
      if (!ticking){
        window.requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, {passive:true});
  })();

  // ============ CERCA: el menú desapareix i apareix la caixa de cerca ============
  (function(){
    var mainNav = document.getElementById('mainNav');
    var searchBox = document.getElementById('searchBox');
    var searchToggle = document.getElementById('searchToggle');
    var searchClose = document.getElementById('searchClose');
    var searchInput = document.getElementById('searchInput');
    var searchResults = document.getElementById('searchResults');

    function openSearch(){
      mainNav.classList.add('is-hidden');
      searchToggle.style.display = 'none';
      searchToggle.setAttribute('aria-expanded', 'true');
      searchBox.hidden = false;
      searchInput.focus();
    }
    function closeSearch(){
      searchBox.hidden = true;
      searchInput.value = '';
      mainNav.classList.remove('is-hidden');
      searchToggle.style.display = '';
      searchToggle.setAttribute('aria-expanded', 'false');
      searchResults.classList.remove('is-visible');
      searchResults.innerHTML = '';
    }
    searchToggle.addEventListener('click', openSearch);
    searchClose.addEventListener('click', closeSearch);
    searchInput.addEventListener('keydown', function(e){
      if (e.key === 'Escape') closeSearch();
    });

    // --- Índex de cerca: es carrega un sol cop, generat per l'Eleventy a cada build ---
    var indexPromise = null;
    function loadIndex(){
      if (!indexPromise){
        indexPromise = fetch('/search-index.json').then(function(r){ return r.json(); });
      }
      return indexPromise;
    }

    function renderResults(matches, query){
      searchResults.innerHTML = '';
      if (!query){
        searchResults.classList.remove('is-visible');
        return;
      }
      if (matches.length === 0){
        var empty = document.createElement('div');
        empty.className = 'search-results__empty';
        empty.textContent = '{{ t.search.noResults }} "' + query + '"';
        searchResults.appendChild(empty);
      } else {
        matches.slice(0, 8).forEach(function(item){
          var a = document.createElement('a');
          a.href = item.url;
          a.textContent = item.title;
          searchResults.appendChild(a);
        });
      }
      searchResults.classList.add('is-visible');
    }

    var currentLang = document.documentElement.lang || 'ca';

    searchInput.addEventListener('input', function(){
      var query = searchInput.value.trim().toLowerCase();
      if (!query){ renderResults([], ''); return; }
      loadIndex().then(function(data){
        var matches = data.filter(function(item){
          return item.lang === currentLang && item.title.toLowerCase().indexOf(query) !== -1;
        });
        renderResults(matches, query);
      });
    });
  })();

  // ============ MENÚ MÒBIL (desplegable) ============
  (function(){
    var menuToggle = document.getElementById('menuToggle');
    var mobilePanel = document.getElementById('mobileNavPanel');

    menuToggle.addEventListener('click', function(){
      var isOpen = mobilePanel.classList.toggle('is-open');
      menuToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  })();

  // ============ DESPLEGABLES DEL MENÚ (escriptori: clic + hover) ============
  // Funciona per a qualsevol <li class="has-dropdown"> — no cal repetir
  // aquest bloc quan afegim un desplegable nou a un altre apartat.
  (function(){
    var items = document.querySelectorAll('.has-dropdown');
    if (!items.length) return;

    function closeAll(except){
      items.forEach(function(item){
        if (item === except) return;
        item.classList.remove('is-open');
        var trg = item.querySelector('.dropdown-trigger');
        if (trg) trg.setAttribute('aria-expanded', 'false');
      });
    }

    items.forEach(function(item){
      var trigger = item.querySelector('.dropdown-trigger');
      if (!trigger) return;
      trigger.addEventListener('click', function(e){
        e.preventDefault();
        var isOpen = item.classList.toggle('is-open');
        trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        if (isOpen) closeAll(item);
      });
    });

    document.addEventListener('click', function(e){
      items.forEach(function(item){
        if (!item.contains(e.target)) {
          item.classList.remove('is-open');
          var trg = item.querySelector('.dropdown-trigger');
          if (trg) trg.setAttribute('aria-expanded', 'false');
        }
      });
    });
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape') closeAll(null);
    });
  })();

  // ============ ACORDIONS DEL MENÚ (mòbil) ============
  // Funciona per a qualsevol <li class="mobile-nav-item has-submenu">.
  (function(){
    var items = document.querySelectorAll('.mobile-nav-item.has-submenu');
    items.forEach(function(item){
      var trigger = item.querySelector('.mobile-nav-item__trigger');
      if (!trigger) return;
      trigger.addEventListener('click', function(){
        var isOpen = item.classList.toggle('is-open');
        trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });
  })();

  // ============ CAPÇALERA COMUNA: efecte en fer scroll ============
  // La foto es desplaça més a poc a poc que la pàgina i es va esvaint; la caixa
  // puja més de pressa que la pàgina i perd el fons blanc i l'ombra, de manera
  // que al final només en queda el text (títol i subtítol) sobre el fons blanc.
  (function(){
    var hero = document.getElementById('qsHero');
    if (!hero) return;
    var img = hero.querySelector('img');
    var box = hero.querySelector('.qs-hero__box');
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var ticking = false;

    function update(){
      ticking = false;
      var h = hero.offsetHeight;
      var y = Math.max(0, window.scrollY);
      var p = Math.min(1, y / (h * 0.7));
      img.style.transform = 'translate3d(0,' + (y * 0.35).toFixed(1) + 'px,0)';
      img.style.opacity = (1 - p).toFixed(3);
      box.style.transform = 'translate3d(0,' + (-y * 0.15).toFixed(1) + 'px,0)';
      box.style.backgroundColor = 'rgba(255,255,255,' + (0.72 * (1 - p)).toFixed(3) + ')';
      box.style.boxShadow = '0 14px 34px rgba(15,8,90,' + (0.18 * (1 - p)).toFixed(3) + ')';
      box.style.backdropFilter = p > 0.02 ? 'none' : '';
    }
    function onScroll(){
      if (!ticking){ ticking = true; requestAnimationFrame(update); }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  })();
