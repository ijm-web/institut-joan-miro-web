<!DOCTYPE html>
{%- set lang = lang | default('ca') -%}
{%- set slug = slug | default('index.html') -%}
{%- set langPrefix = '' -%}
{%- if lang == 'es' -%}{%- set langPrefix = 'es/' -%}
{%- elif lang == 'en' -%}{%- set langPrefix = 'en/' -%}
{%- endif -%}
{%- set t = i18n[lang] -%}
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<link rel="preload" href="/assets/fonts/montserrat-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<style>
  /* Tipografia del web: Montserrat (variable, gruixos 100–900), allotjada al propi web */
  @font-face{
    font-family: 'Montserrat';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/assets/fonts/montserrat-latin-wght-normal.woff2') format('woff2');
  }
  @font-face{
    font-family: 'Montserrat';
    font-style: italic;
    font-weight: 100 900;
    font-display: swap;
    src: url('/assets/fonts/montserrat-latin-wght-italic.woff2') format('woff2');
  }

  :root{
    --color-bg: #ffffff;
    --color-blue: #1C0CBC;      /* blau extret directament del logotip (blau Miró) */
    --color-orange: #E8600C;    /* to càlid de la paleta Miró, per als hovers de text */
    --color-gray-icon: #9096A0; /* gris per al hover de les icones */
    --color-border: #E9EAEE;
    --color-text-muted: #6b7280;
    --topbar-height: 40px;
    --font-main: 'Montserrat', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  *{ box-sizing: border-box; }
  html,body{ margin:0; padding:0; }
  body{
    font-family: var(--font-main);
    background: var(--color-bg);
    color: var(--color-blue);
    min-height: 100%;
    display: flex;
    flex-direction: column;
  }

  a{ color: inherit; text-decoration: none; }
  button{ font-family: inherit; }

  /* ============ CONTENIDOR FIX: barra superior + menú horitzontal ============ */
  .site-header{
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: var(--color-bg);
    box-shadow: 0 0px 0px rgba(28,12,188,0);
    transition: box-shadow 0.3s ease;
  }
  .site-header.has-shadow{
    box-shadow: 0 2px 10px rgba(28,12,188,0.08);
  }

  /* ============ BARRA SUPERIOR (col·lapsable) ============ */
  .topbar{
    height: var(--topbar-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(16px, 4vw, 48px);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
    transition: height 0.28s ease, border-color 0.28s ease, opacity 0.2s ease;
  }
  .topbar.is-collapsed{
    height: 0;
    border-bottom-color: transparent;
    opacity: 0;
  }

  .topbar__group{
    display: flex;
    align-items: center;
    gap: 18px;
    height: 100%;
    flex-shrink: 0;
  }

  .lang-switch{
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .lang-switch a{
    color: var(--color-blue);
    padding: 4px 2px;
    position: relative;
    transition: color 0.18s ease;
  }
  .lang-switch a:hover,
  .lang-switch a:focus-visible{
    color: var(--color-orange);
  }
  .lang-switch a[aria-current="true"]{
    color: var(--color-orange);
  }
  .lang-switch a[aria-current="true"]::after{
    content:"";
    position:absolute;
    left:0; right:0; bottom:-2px;
    height:2px;
    background: var(--color-orange);
    border-radius: 2px;
  }
  .lang-divider{
    color: var(--color-border);
    font-size: 12px;
  }

  .social-links{
    display: flex;
    align-items: center;
    gap: 12px;
    padding-left: 14px;
    border-left: 1px solid var(--color-border);
  }
  .social-links a{
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    color: var(--color-blue);
    transition: color 0.18s ease, transform 0.18s ease;
  }
  .social-links a:hover,
  .social-links a:focus-visible{
    color: var(--color-gray-icon);
    transform: translateY(-1px);
  }
  .social-links svg{ width: 17px; height: 17px; display:block; }

  /* Ara viu a .header-actions (capçalera principal), a l'esquerra
     del cercador — ja no forma part de la barra superior ni del
     menú. Mateixos colors/aparença que abans; només s'hi ha afegit
     un separador visual perquè quedi ben integrat entre les icones. */
  .intranet-link{
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 12.5px;
    font-weight: 600;
    padding-right: 14px;
    margin-right: 6px;
    border-right: 1px solid var(--color-border);
    height: 20px;
  }
  .intranet-link img{
    height: 18px;
    width: auto;
    display: block;
    transition: filter 0.18s ease, opacity 0.18s ease;
  }
  .intranet-link:hover img,
  .intranet-link:focus-visible img{
    filter: grayscale(1) opacity(0.55);
  }
  @media (max-width: 560px){
    .intranet-link{ padding-right: 10px; margin-right: 2px; }
    .intranet-link img{ height: 16px; }
  }
  /* ============ MENÚ HORITZONTAL (placeholder visual — sempre visible) ============ */
  .mainheader{
    display:flex;
    align-items:center;
    justify-content: space-between;
    padding: 14px clamp(16px, 4vw, 48px);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .brand{
    display:flex;
    align-items:center;
  }
  .mainheader{
    display:flex;
    align-items:center;
    justify-content: space-between;
    padding: 14px clamp(16px, 4vw, 48px);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    gap: 16px;
  }
  .brand{
    display:flex;
    align-items:center;
    flex-shrink: 0;
  }
  .brand img{
    height: 46px;
    width: auto;
    display:block;
  }

  /* --- Zona central: nav + cerca, centrades entre logo i accions --- */
  .nav-center{
    flex: 1;
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .header-actions{
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .main-nav ul{
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 18px;
    flex-wrap: nowrap;
  }
  .main-nav a{
    display: inline-block;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-blue);
    padding: 8px 2px;
    white-space: nowrap;
    position: relative;
    transition: color 0.18s ease;
  }
  .main-nav a::after{
    content: "";
    position: absolute;
    left: 0; right: 100%;
    bottom: 2px;
    height: 2px;
    background: var(--color-orange);
    transition: right 0.22s ease;
    border-radius: 2px;
  }
  .main-nav a:hover,
  .main-nav a:focus-visible{
    color: var(--color-orange);
  }
  .main-nav a:hover::after,
  .main-nav a:focus-visible::after{
    right: 0;
  }

  .search-toggle,
  .search-close,
  .menu-toggle{
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border: none;
    background: none;
    color: var(--color-blue);
    cursor: pointer;
    padding: 0;
    transition: color 0.18s ease;
  }
  .search-toggle:hover,
  .search-toggle:focus-visible,
  .search-close:hover,
  .search-close:focus-visible,
  .menu-toggle:hover,
  .menu-toggle:focus-visible{
    color: var(--color-gray-icon);
  }
  .search-toggle svg,
  .search-close svg,
  .menu-toggle svg{
    width: 20px;
    height: 20px;
  }

  /* --- Caixa de cerca: substitueix el menú quan s'obre --- */
  .search-box{
    display: flex;
    align-items: center;
    flex: 1;
    max-width: 480px;
    border-bottom: 2px solid var(--color-blue);
    gap: 8px;
    position: relative;
  }
  .search-box[hidden]{ display: none; }
  .search-box input{
    flex: 1;
    border: none;
    outline: none;
    font-family: inherit;
    font-size: 15px;
    color: var(--color-blue);
    padding: 7px 2px;
    background: transparent;
  }
  .search-box input::placeholder{
    color: var(--color-text-muted);
    font-weight: 400;
  }

  /* --- Resultats de cerca --- */
  .search-results{
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    right: 0;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: 0 16px 34px rgba(28,12,188,0.12);
    padding: 8px;
    display: none;
    flex-direction: column;
    gap: 1px;
    max-height: 340px;
    overflow-y: auto;
    z-index: 30;
  }
  .search-results.is-visible{ display: flex; }
  .search-results a{
    display: block;
    padding: 10px 12px;
    border-radius: 5px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-blue);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .search-results a:hover,
  .search-results a:focus-visible{
    background: rgba(28,12,188,0.06);
    color: var(--color-orange);
  }
  .search-results__empty{
    padding: 10px 12px;
    font-size: 13.5px;
    color: var(--color-text-muted);
  }

  .main-nav.is-hidden{ display: none; }

  /* --- Desplegable "El Centre" (escriptori) --- */
  .has-dropdown{
    position: relative;
  }
  .dropdown-trigger{
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font: inherit;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-blue);
    padding: 8px 2px;
    white-space: nowrap;
    position: relative;
    transition: color 0.18s ease;
  }
  .dropdown-trigger::after{
    content: "";
    position: absolute;
    left: 0; right: 100%;
    bottom: 2px;
    height: 2px;
    background: var(--color-orange);
    transition: right 0.22s ease;
    border-radius: 2px;
  }
  .dropdown-trigger:hover,
  .dropdown-trigger:focus-visible,
  .has-dropdown.is-open .dropdown-trigger{
    color: var(--color-orange);
  }
  .dropdown-trigger:hover::after,
  .dropdown-trigger:focus-visible::after,
  .has-dropdown.is-open .dropdown-trigger::after{
    right: 0;
  }
  .dropdown-trigger svg{
    width: 13px;
    height: 13px;
    transition: transform 0.18s ease;
  }
  .has-dropdown.is-open .dropdown-trigger svg{
    transform: rotate(180deg);
  }

  .dropdown-panel{
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, 6px);
    min-width: 240px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: 0 16px 34px rgba(28,12,188,0.12);
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 1px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.16s ease, transform 0.16s ease;
    z-index: 20;
  }
  .has-dropdown:hover .dropdown-panel,
  .has-dropdown.is-open .dropdown-panel{
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }
  .dropdown-panel a{
    display: block;
    padding: 9px 12px;
    border-radius: 5px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-blue);
    white-space: nowrap;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .dropdown-panel a:hover,
  .dropdown-panel a:focus-visible{
    background: rgba(28,12,188,0.06);
    color: var(--color-orange);
  }
  .dropdown-panel__group{
    position: relative;
    margin: 4px 0;
    padding-top: 6px;
    border-top: 1px solid var(--color-border);
  }
  .dropdown-panel__group-trigger{
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 9px 12px;
    border-radius: 5px;
    font-size: 13.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--color-blue);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .dropdown-panel__group-trigger svg{
    width: 11px;
    height: 11px;
    flex-shrink: 0;
    transform: rotate(-90deg);
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }
  .dropdown-panel__group:hover .dropdown-panel__group-trigger,
  .dropdown-panel__group.is-open .dropdown-panel__group-trigger{
    background: rgba(28,12,188,0.06);
    color: var(--color-orange);
  }
  .dropdown-panel__group:hover .dropdown-panel__group-trigger svg,
  .dropdown-panel__group.is-open .dropdown-panel__group-trigger svg{
    color: var(--color-orange);
  }

  /* --- Flyout del tercer nivell: només visible amb el ratolí a sobre --- */
  .dropdown-panel__flyout{
    position: absolute;
    top: -10px;
    left: 100%;
    margin-left: 6px;
    min-width: 200px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: 0 16px 34px rgba(28,12,188,0.12);
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 1px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(-6px);
    transition: opacity 0.16s ease, transform 0.16s ease;
    z-index: 25;
  }
  .dropdown-panel__group:hover .dropdown-panel__flyout{
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0);
  }
  /* Els menús de la dreta (Secretaria) obren el flyout cap a l'esquerra per no sortir de la pantalla */
  .dropdown-panel__group--left .dropdown-panel__flyout{
    left: auto;
    right: 100%;
    margin-left: 0;
    margin-right: 6px;
    transform: translateX(6px);
  }
  .dropdown-panel__group--left .dropdown-panel__group-trigger svg{ transform: rotate(90deg); }
  .dropdown-panel__group--left:hover .dropdown-panel__flyout{ transform: translateX(0); }
  .dropdown-panel__flyout a{
    display: block;
    padding: 9px 12px;
    border-radius: 5px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-blue);
    white-space: nowrap;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .dropdown-panel__flyout a:hover,
  .dropdown-panel__flyout a:focus-visible{
    background: rgba(28,12,188,0.06);
    color: var(--color-orange);
  }

  /* --- Mòbil: el menú es col·lapsa dins un desplegable --- */
  .menu-toggle{ display: none; }
  .mobile-nav-panel{
    display: none;
  }

  /* ============ CONTINGUT (creixerà per omplir l'espai; es dissenyarà més endavant) ============ */
  .demo-content{
    flex: 1;
    padding: 64px clamp(16px, 4vw, 48px);
    max-width: 900px;
  }
  .demo-content h1{
    font-size: 22px;
    color: var(--color-blue);
    margin-bottom: 12px;
  }
  .demo-content p{
    color: var(--color-text-muted);
    line-height: 1.7;
    font-size: 15px;
  }

  /* ============ PEU ============ */
  /* Estil inspirat en la barra legal inferior de La Salle Gràcia: prima, neutra, */
  /* copyright a l'esquerra i enllaços legals a la dreta, amb el mateix llenguatge */
  /* visual (divisors fins) que ja fem servir al selector d'idioma de la barra superior. */
  .site-footer{
    border-top: 1px solid var(--color-border);
    padding: 10px clamp(16px, 4vw, 48px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 12.5px;
  }
  .footer-copyright{
    color: var(--color-text-muted);
    font-weight: 500;
    white-space: nowrap;
  }
  .footer-legal{
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .footer-legal a{
    color: var(--color-blue);
    font-weight: 600;
    padding: 4px 2px;
    transition: color 0.18s ease;
  }
  .footer-legal a:hover,
  .footer-legal a:focus-visible{
    color: var(--color-orange);
  }
  .footer-divider{
    color: var(--color-border);
    font-size: 12px;
  }

  /* --- Mida del menú d'escriptori segons l'amplada (va després de les regles
     base de .main-nav a i .dropdown-trigger perquè les pugui sobreescriure) --- */
  /* Montserrat és una lletra ampla: en pantalles mitjanes el menú es compacta
     una mica perquè hi càpiga (l'anglès és la versió més llarga). */
  @media (max-width: 1499px){
    .main-nav ul{ gap: 10px; }
    .main-nav a,
    .dropdown-trigger{ font-size: 12.5px; letter-spacing: 0.01em; }
  }
  /* Portàtils i tauletes en horitzontal (1050–1360 px): el menú es manté en una
     sola fila entre el logo i Clickedu; per fer-hi lloc, la capçalera es compacta
     (menys marge, logo una mica més petit) i la lletra del menú es redueix per trams.
     Per sota de 1050 px s'utilitza el menú mòbil (botó de tres ratlles). */
  @media (min-width: 1050px) and (max-width: 1360px){
    .mainheader{
      padding-left: 20px;
      padding-right: 20px;
      gap: 12px;
    }
    .brand img{ height: 38px; }
    .main-nav ul{ gap: 8px; }
    .main-nav a,
    .dropdown-trigger{ font-size: 12px; letter-spacing: 0; }
  }
  @media (min-width: 1050px) and (max-width: 1199px){
    .main-nav ul{ gap: 5px; }
    .main-nav a,
    .dropdown-trigger{ font-size: 11px; font-weight: 500; }
  }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 1049px){
    .main-nav{ display: none; }
    .menu-toggle{ display: flex; }
    .mobile-nav-panel{
      display: block;
      max-height: 0;
      overflow: hidden;
      border-top: 1px solid var(--color-border);
      transition: max-height 0.28s ease;
    }
    .mobile-nav-panel.is-open{
      /* Prou gran perquè hi càpiguen tots els elements del menú (incl.
         "Inici") i els desplegables oberts, i encara permetre scroll
         intern si mai calgués en una pantalla molt baixa. */
      max-height: min(80vh, 1200px);
      overflow-y: auto;
    }
    .mobile-nav-panel ul{
      list-style: none;
      margin: 0;
      padding: 6px clamp(16px, 4vw, 48px) 14px;
      display: flex;
      flex-direction: column;
    }
    .mobile-nav-panel a{
      display: block;
      padding: 11px 2px;
      font-size: 15px;
      font-weight: 600;
      color: var(--color-blue);
      border-bottom: 1px solid var(--color-border);
      transition: color 0.18s ease;
    }
    .mobile-nav-panel li:last-child a{ border-bottom: none; }
    .mobile-nav-panel a:hover,
    .mobile-nav-panel a:focus-visible{
      color: var(--color-orange);
    }

    /* --- Acordió "El Centre" (mòbil) --- */
    .mobile-nav-item.has-submenu > .mobile-nav-item__trigger{
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: none;
      border: none;
      border-bottom: 1px solid var(--color-border);
      font: inherit;
      font-size: 15px;
      font-weight: 600;
      color: var(--color-blue);
      padding: 11px 2px;
      cursor: pointer;
    }
    .mobile-nav-item__trigger svg{
      width: 16px;
      height: 16px;
      transition: transform 0.18s ease;
      flex-shrink: 0;
    }
    .mobile-nav-item.is-open .mobile-nav-item__trigger svg{
      transform: rotate(180deg);
    }
    /* Selector més específic que ".mobile-nav-panel ul": sense això, el submenú
       tancat heretava el padding de la llista principal i en deixava veure un tros. */
    .mobile-nav-panel .mobile-submenu{
      list-style: none;
      margin: 0;
      padding: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.24s ease;
    }
    .mobile-nav-item.is-open .mobile-submenu{
      max-height: 480px;
    }
    .mobile-submenu a{
      display: block;
      padding: 10px 2px 10px 16px;
      font-size: 14px;
      font-weight: 500;
      color: var(--color-blue);
      border-bottom: 1px solid var(--color-border);
    }
    .mobile-submenu a.mobile-submenu__sub{
      padding-left: 32px;
    }
    .mobile-submenu__group-label{
      padding: 10px 2px 4px 16px;
      font-size: 13px;
      font-weight: 700;
      color: var(--color-text-muted);
      border-bottom: 1px solid var(--color-border);
    }
    .search-box{ max-width: none; }
  }
  @media (max-width: 640px){
    :root{ --topbar-height: 38px; }
    .lang-switch{ font-size: 11.5px; gap: 6px; }
    .social-links{ padding-left: 10px; gap: 8px; }
    .topbar__group{ gap: 10px; }
  }
  @media (max-width: 400px){
    .social-links{ display: none; }
  }
  @media (max-width: 480px){
    .site-footer{
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 10px;
    }
  }

  /* ============ CAPÇALERA COMUNA DE LES PÀGINES INTERIORS ============ */
  /* Foto a tota amplada amb una caixa semitransparent a baix a la dreta (títol + subtítol).
     Marcatge: <div class="qs-hero" id="qsHero"><img ...><div class="qs-hero__box"><h1>
     <span class="qs-hero__title">…</span><span class="qs-hero__subtitle">…</span></h1></div></div> */
  .qs-hero{
    position: relative;
    width: 100%;
    height: clamp(260px, 34vw, 500px);
    overflow: hidden;
    background: var(--color-bg);
  }
  .qs-hero img{
    will-change: transform, opacity;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
    display: block;
  }
  .qs-hero__box{
    position: absolute;
    right: clamp(16px, 5vw, 64px);
    bottom: clamp(24px, 5vw, 56px);
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(3px);
    padding: clamp(18px, 2.6vw, 34px) clamp(22px, 3.4vw, 48px);
    border-radius: 4px;
    max-width: calc(100% - 32px);
    box-shadow: 0 14px 34px rgba(15, 8, 90, 0.18);
    will-change: transform;
  }
  .qs-hero__box h1{
    margin: 0;
    color: var(--color-blue);
    text-transform: uppercase;
    line-height: 1.05;
  }
  .qs-hero__title{
    display: block;
    font-size: clamp(28px, 4.4vw, 60px);
    font-weight: 300;
    letter-spacing: 0.01em;
  }
  .qs-hero__subtitle{
    display: block;
    margin-top: 0.45em;
    font-size: clamp(15px, 1.9vw, 26px);
    font-weight: 500;
    letter-spacing: 0.03em;
  }
{{ pageStyles | safe }}
