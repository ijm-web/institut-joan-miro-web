{% raw %}
<script>
  // ============ ESO / Batxillerat: pestanyes del currículum per nivell ============
  (function(){
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.eso-tabs [role="tab"]'));
    if (!tabs.length) return;
    function select(tab){
      tabs.forEach(function(t){
        var on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        var panel = document.getElementById(t.getAttribute('aria-controls'));
        if (panel) panel.hidden = !on;
      });
    }
    tabs.forEach(function(t, i){
      t.addEventListener('click', function(){ select(t); });
      t.addEventListener('keydown', function(ev){
        var n = null;
        if (ev.key === 'ArrowRight') n = tabs[(i + 1) % tabs.length];
        else if (ev.key === 'ArrowLeft') n = tabs[(i - 1 + tabs.length) % tabs.length];
        else if (ev.key === 'Home') n = tabs[0];
        else if (ev.key === 'End') n = tabs[tabs.length - 1];
        if (n){ ev.preventDefault(); select(n); n.focus(); }
      });
    });
  })();

  // ============ Orientació (4t d'ESO / 2n de Batxillerat): bloc plegable, ocult per defecte ============
  (function(){
    var btn = document.querySelector('.eso-guide-toggle__btn');
    if (!btn) return;
    var guia = document.getElementById(btn.getAttribute('aria-controls'));
    var accio = btn.querySelector('.eso-guide-toggle__accio');
    function posa(obert){
      guia.hidden = !obert;
      btn.setAttribute('aria-expanded', obert ? 'true' : 'false');
      accio.textContent = obert ? accio.getAttribute('data-amaga') : accio.getAttribute('data-mostra');
    }
    btn.addEventListener('click', function(){ posa(guia.hidden); });
    // L'enllaç «… ↓» de la columna d'orientació obre el bloc i hi porta
    document.querySelectorAll('[data-obre-guia]').forEach(function(a){
      a.addEventListener('click', function(ev){
        ev.preventDefault();
        posa(true);
        btn.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
    if (location.hash === '#' + guia.id){ posa(true); setTimeout(function(){ btn.scrollIntoView(); }, 50); }
  })();
</script>
{% endraw %}
