{% raw %}
<script>
  // ============ Criteris de qualificació: PDF per nivell amb les dades de programacions_db ============
  // Enllaços amb data-criteris="ESO 1r"… → /api/criteris-publics → PDF (assets/js/criteris-pdf.js) en una pestanya nova.
  document.addEventListener('DOMContentLoaded', function(){
    var enllacos = document.querySelectorAll('[data-criteris]');
    if (!enllacos.length) return;
    var lang = (document.documentElement.lang || 'ca').slice(0, 2);
    var TX = {
      ca: { gen: 'Generant el PDF dels criteris de qualificació…', titol: 'Criteris de qualificació', curs: 'Curs', mat: 'Matèria', act: 'Actualització',
        nota: 'Hi surten les matèries que ja han publicat els seus criteris. La resta s’hi aniran afegint.', buit: 'Encara no s’han publicat els criteris de qualificació d’aquest nivell.',
        error: 'No s’ha pogut generar el PDF. Torneu-ho a provar d’aquí a una estona.', actualitzat: 'Actualitzat el', fitxer: 'criteris-qualificacio' },
      es: { gen: 'Generando el PDF de los criterios de calificación…', titol: 'Criterios de calificación', curs: 'Curso', mat: 'Materia', act: 'Actualización',
        nota: 'Aparecen las materias que ya han publicado sus criterios. El resto se irán añadiendo.', buit: 'Todavía no se han publicado los criterios de calificación de este nivel.',
        error: 'No se ha podido generar el PDF. Vuelva a intentarlo dentro de un rato.', actualitzat: 'Actualizado el', fitxer: 'criterios-calificacion' },
      en: { gen: 'Generating the assessment criteria PDF…', titol: 'Assessment criteria', curs: 'School year', mat: 'Subject', act: 'Updated',
        nota: 'Only subjects that have already published their criteria are included. The rest will be added.', buit: 'The assessment criteria for this level have not been published yet.',
        error: 'The PDF could not be generated. Please try again later.', actualitzat: 'Updated on', fitxer: 'assessment-criteria' }
    }[lang] || {};
    var data = function(d){ var m = String(d || '').match(/^(\d{4})-(\d{2})-(\d{2})/); return m ? Number(m[3]) + '/' + Number(m[2]) + '/' + m[1] : ''; };
    var esc = function(t){ return String(t).replace(/[&<>]/g, function(c){ return { '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]; }); };
    function avis(w, text){
      if (w && !w.closed) w.document.body.innerHTML = '<p style="font:16px/1.6 Montserrat,system-ui,sans-serif;color:#1E1E2A;max-width:560px;margin:15vh auto;padding:0 16px;text-align:center">' + esc(text) + '</p>';
      else if (window.alert) alert(text);
    }
    Array.prototype.forEach.call(enllacos, function(a){
      a.addEventListener('click', function(ev){
        ev.preventDefault();
        var nivell = a.getAttribute('data-criteris'), nom = a.getAttribute('data-nom') || nivell;
        // La pestanya s'obre en el moment del clic (si s'obre després, el navegador la bloqueja)
        var w = window.open('', '_blank');
        if (w) { w.document.title = TX.titol + ' · ' + nom; avis(w, TX.gen); }
        var crida = fetch('/api/criteris-publics?nivell=' + encodeURIComponent(nivell)).then(function(r){ return r.json(); });
        var feina = Promise.all([crida, CriterisPdf.prepara()]);
        (window.Progres ? Progres.amb(feina.then(function(x){ return x; }), TX.gen) : feina).then(function(x){
          var d = x[0], R = x[1];
          if (!d || !d.ok) throw new Error((d && d.error) || 'error');
          var materies = d.materies.filter(function(m){ var i = m.info || {}; return m.criteris.length || m.competencies.length || i.criteri_aprovar || i.recuperacio || i.observacions; });
          var doc = CriterisPdf.genera(R, {
            curs: d.curs, lang: lang, capcalera: TX.titol,
            portada: { titol: TX.titol, subtitol: nom + ' · ' + TX.curs + ' ' + d.curs,
              head: [[TX.mat, TX.act]], body: materies.map(function(m){ return [m.materia, data((m.info || {}).data) || '—']; }),
              columnStyles: { 1: { cellWidth: 34 } }, nota: materies.length ? TX.nota : TX.buit },
            competenciesDigitals: d.competencies_digitals,
            materies: materies.map(function(m){
              var dt = data((m.info || {}).data);
              return { titol: m.materia, pagina: nom + ' · ' + m.materia, subtitol: nom + (dt ? ' · ' + TX.actualitzat + ' ' + dt : ''), senseCD: /^BAT/.test(nivell),
                criteris: m.criteris, competencies: m.competencies, info: m.info || {} };
            })
          });
          doc.setProperties({ title: TX.titol + ' · ' + nom + ' · ' + d.curs });
          var fitxer = TX.fitxer + '-' + nivell.toLowerCase().replace(/\s+/g, '-') + '-' + d.curs + '.pdf';
          if (w && !w.closed) w.location.href = doc.output('bloburl', { filename: fitxer });
          else doc.save(fitxer);
        }).catch(function(err){
          var codi = err && err.message && err.message !== 'error' ? err.message : '';
          avis(w, TX.error + (codi ? ' (' + codi + ')' : ''));
          if (window.console) console.error(err);
        });
      });
    });
  });

  // ============ ESO / Batxillerat: pestanyes del currículum per nivell ============
  (function(){
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.eso-tabs [role="tab"]'));
    if (!tabs.length) return;
    function select(tab){
      tabs.forEach(function(t){
        var on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        var panel = document.getElementById(t.getAttribute('aria-controls'));
        if (panel) panel.hidden = !on;
      });
    }
    tabs.forEach(function(t, i){
      t.addEventListener('click', function(){ select(t); });
      t.addEventListener('keydown', function(ev){
        var n = null;
        if (ev.key === 'ArrowRight') n = tabs[(i + 1) % tabs.length];
        else if (ev.key === 'ArrowLeft') n = tabs[(i - 1 + tabs.length) % tabs.length];
        else if (ev.key === 'Home') n = tabs[0];
        else if (ev.key === 'End') n = tabs[tabs.length - 1];
        if (n){ ev.preventDefault(); select(n); n.focus(); }
      });
    });
  })();

  // ============ Batxillerat: botons d'itinerari (sincronitzats entre 1r i 2n) ============
  (function(){
    var grups = Array.prototype.slice.call(document.querySelectorAll('.eso-ittabs'));
    if (!grups.length) return;
    function tria(n, focus){
      grups.forEach(function(g){
        var bs = Array.prototype.slice.call(g.querySelectorAll('[role="tab"]'));
        bs.forEach(function(b){
          var on = b.getAttribute('data-it') === String(n);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
          b.tabIndex = on ? 0 : -1;
          var p = document.getElementById(b.getAttribute('aria-controls'));
          if (p) p.hidden = !on;
          if (on && focus === g) b.focus();
        });
      });
    }
    grups.forEach(function(g){
      var bs = Array.prototype.slice.call(g.querySelectorAll('[role="tab"]'));
      bs.forEach(function(b, i){
        b.addEventListener('click', function(){ tria(b.getAttribute('data-it')); });
        b.addEventListener('keydown', function(ev){
          var k = null;
          if (ev.key === 'ArrowRight') k = (i + 1) % bs.length;
          else if (ev.key === 'ArrowLeft') k = (i - 1 + bs.length) % bs.length;
          else if (ev.key === 'Home') k = 0;
          else if (ev.key === 'End') k = bs.length - 1;
          if (k !== null){ ev.preventDefault(); tria(bs[k].getAttribute('data-it'), g); }
        });
      });
    });
  })();

  // ============ Orientació (4t d'ESO / 2n de Batxillerat): bloc plegable, ocult per defecte ============
  (function(){
    var btn = document.querySelector('.eso-guide-toggle__btn');
    if (!btn) return;
    var guia = document.getElementById(btn.getAttribute('aria-controls'));
    var accio = btn.querySelector('.eso-guide-toggle__accio');
    function posa(obert){
      guia.hidden = !obert;
      btn.setAttribute('aria-expanded', obert ? 'true' : 'false');
      accio.textContent = obert ? accio.getAttribute('data-amaga') : accio.getAttribute('data-mostra');
    }
    btn.addEventListener('click', function(){ posa(guia.hidden); });
    // L'enllaç «… ↓» de la columna d'orientació obre el bloc i hi porta
    document.querySelectorAll('[data-obre-guia]').forEach(function(a){
      a.addEventListener('click', function(ev){
        ev.preventDefault();
        posa(true);
        btn.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
    if (location.hash === '#' + guia.id){ posa(true); setTimeout(function(){ btn.scrollIntoView(); }, 50); }
  })();
</script>
{% endraw %}
