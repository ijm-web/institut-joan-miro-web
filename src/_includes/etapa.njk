{#- Estudis › ESO i Batxillerat: marcatge comú de les dues pàgines (ca/es/en).
    Cada pàgina defineix `lang` i, abans de l'include, `{% set etapaDades = eso %}` o `batxillerat`.
    Dades: src/_data/eso.json i src/_data/batxillerat.json. Estils: src/assets/css/eso.css.
    Els textos comuns (horari marc, centre sense mòbils, tutoria, franja final) surten sempre d'eso.json,
    així només s'escriuen una vegada. Les dades pendents porten la classe `tbd` (fons groc). -#}
{%- set L = lang | default('ca') -%}
{%- set P = '' -%}
{%- if L == 'es' -%}{%- set P = 'es/' -%}{%- elif L == 'en' -%}{%- set P = 'en/' -%}{%- endif -%}
{%- set e = etapaDades if etapaDades else eso -%}
{%- set E = eso -%}
{%- set icones = {
  'sintesi': '<path d="M9 3h4v3a2 2 0 1 0 4 0V3h4v8h-3a2 2 0 1 0 0 4h3v6h-8v-3a2 2 0 1 0-4 0v3H3v-8h3a2 2 0 1 0 0-4H3V3z"/>',
  'recerca': '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/><path d="M8 10.5h5M10.5 8v5"/>',
  'llengues': '<path d="M4 5h9v7H8l-4 3z"/><path d="M11 12v2h5l4 3v-9h-7"/><path d="M6.5 8.5h4"/>',
  'lectura': '<path d="M12 6c-2-1.5-5-2-8-1.5v14c3-.5 6 0 8 1.5 2-1.5 5-2 8-1.5v-14c-3-.5-6 0-8 1.5z"/><path d="M12 6v14"/>',
  'tr': '<path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z"/><path d="M14 3v5h5"/><circle cx="11" cy="14" r="2.5"/><path d="M13 16l2.5 2.5"/>'
} -%}
<div class="eso-page">

<div class="qs-hero" id="qsHero">
  {%- set himg = e.heroImg or 'inici-2-passadis' %}
  <img src="/assets/img/inici/{{ himg }}-2400.jpg" srcset="/assets/img/inici/{{ himg }}-1600.jpg 1600w, /assets/img/inici/{{ himg }}-2400.jpg 2400w" sizes="100vw" width="2400" height="900" fetchpriority="high" alt="" role="presentation">
  <div class="qs-hero__box">
    <h1><span class="qs-hero__title">{{ e.heroTitol[L] }}</span><span class="qs-hero__subtitle">{{ e.heroSubtitol[L] }}</span></h1>
  </div>
</div>

{%- if e.pendent %}<p class="eso-pending-note">{{ e.pendent[L] | safe }}</p>{% endif %}

<!-- ============ INTRODUCCIÓ ============ -->
<div class="eso-wrap">
  <div class="eso-intro">
    <h2 class="eso-kicker">{{ e.kicker[L] }}</h2>
    <p class="eso-lead">{{ e.lead[L] | safe }}</p>
  </div>
  <ul class="eso-stats">
    {%- for s in e.stats %}
    <li><span class="eso-stats__num">{{ s.num }}</span><span class="eso-stats__label">{{ s.label[L] }}</span></li>
    {%- endfor %}
  </ul>
  <nav class="eso-anchors" aria-label="{{ e.heroSubtitol[L] }}">
    {%- for a in e.anchors %}
    <a href="#{{ a.id }}">{{ a.label[L] }}</a>
    {%- endfor %}
  </nav>
</div>

<!-- ============ ORGANITZACIÓ I HORARI ============ -->
<section id="organitzacio" class="eso-band">
  <div class="eso-wrap">
    <h2 class="eso-ttl">{{ e.org.titol[L] }}</h2>
    <div class="eso-row">
      <h3 class="eso-row__head">{{ e.org.comTitol[L] }}</h3>
      <div class="eso-row__body">
        <p>{{ e.org.com1[L] | safe }}</p>
        <p>{{ e.org.com2[L] | safe }}</p>
      </div>
    </div>
    <div class="eso-row">
      <h3 class="eso-row__head">{{ E.org.horariTitol[L] }}</h3>
      <div class="eso-row__body">
        <p>{{ E.org.horariText[L] }}</p>
        <div class="eso-sched" aria-hidden="true">
          <div></div>
          {%- for d in E.org.dies[L] %}<div class="eso-sched__day">{{ d }}</div>{% endfor %}
          <div class="eso-sched__time">8.15–11.15</div>
          {%- for d in E.org.dies[L] %}<div class="eso-sched__cell">{{ E.org.classes[L] }}</div>{% endfor %}
          <div class="eso-sched__time eso-sched__time--break">11.15–11.45</div>
          {%- for d in E.org.dies[L] %}<div class="eso-sched__break">{{ E.org.esbarjo[L] }}</div>{% endfor %}
          <div class="eso-sched__time">11.45–14.45</div>
          {%- for d in E.org.dies[L] %}<div class="eso-sched__cell">{{ E.org.classes[L] }}</div>{% endfor %}
        </div>
      </div>
    </div>
    <div class="eso-row">
      <h3 class="eso-row__head">{{ E.org.mobilsTitol[L] }}</h3>
      <div class="eso-row__body">
        <p class="eso-nophone"><svg aria-hidden="true" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#E8600C" stroke-width="1.6" stroke-linecap="round"><rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M11 18.5h2"/><path d="M3 3l18 18"/></svg><span>{{ E.org.mobilsText[L] }}</span></p>
      </div>
    </div>
    <div class="eso-row">
      <h3 class="eso-row__head">{{ e.org.llenguesTitol[L] }}</h3>
      <div class="eso-row__body">
        <p>{{ e.org.llenguesText[L] }}</p>
        <ul class="eso-chips">
          {%- for l in e.org.llengues[L] %}<li>{{ l }}</li>{% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ============ ARRIBAR A 1r ============ -->
<section id="arribar">
  <div class="eso-wrap">
    <h2 class="eso-ttl">{{ e.arribar.titol[L] }}</h2>
    <p class="eso-sub">{{ e.arribar.text[L] }}</p>
    <ol class="eso-steps">
      {%- for p in e.arribar.passos %}
      <li>
        <span class="eso-steps__num" aria-hidden="true">{{ loop.index }}</span>
        <span class="eso-steps__when">{{ p.quan[L] }}</span>
        <h3>{{ p.titol[L] }}</h3>
        <p>{{ p.text[L] }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<!-- ============ CURRÍCULUM PER NIVELL ============ -->
<section id="curriculum" class="eso-band">
  <div class="eso-wrap">
    <h2 class="eso-ttl">{{ e.curr.titol[L] }}</h2>
    <p class="eso-sub">{{ e.curr.sub[L] }}</p>
    <div class="eso-tabs" role="tablist" aria-label="{{ e.curr.tabsLabel[L] }}">
      {%- for c in e.curr.cursos %}
      <button type="button" role="tab" id="eso-tab-{{ loop.index }}" aria-controls="eso-panel-{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ c.label[L] }}</button>
      {%- endfor %}
    </div>
    {%- for c in e.curr.cursos %}
    {%- set ci = loop.index %}
    <div class="eso-panel" role="tabpanel" id="eso-panel-{{ loop.index }}" aria-labelledby="eso-tab-{{ loop.index }}"{% if not loop.first %} hidden{% endif %}>
      <div class="eso-common">
        <div class="eso-common__head">
          <h3>{{ e.curr.comunes[L] }} · {{ c.label[L] }}</h3>
          <span>{{ e.curr.hores[L] }}</span>
        </div>
        <ul class="eso-subjects">
          {%- for m in c.comunes %}
          <li><span{% if c.comunesPendent %} class="tbd"{% endif %}>{{ m[L] }}{% if m.nota %} <small class="eso-subjects__note">({{ m.nota[L] }})</small>{% endif %}</span>{% if m.h %}<span class="eso-subjects__h">{{ m.h }} h</span>{% else %}<span class="tbd">[h]</span>{% endif %}</li>
          {%- endfor %}
        </ul>
      </div>
      <div class="eso-side">
        <div class="eso-opts">
          <h3>{{ (e.curr.franjaTitol[L] if c.franges else e.curr.optatives[L]) }} · {{ c.label[L] }}</h3>
          <p>{{ c.optText[L] | safe }}</p>
          {%- if c.franges %}
          {%- for f in c.franges %}
          <h4 class="eso-opts__band">{{ f.n[L] }}</h4>
          <ul>
            {%- for o in f.opts %}<li>{{ o.n[L] }}</li>{% endfor %}
          </ul>
          {%- endfor %}
          {%- elif c.opts %}
          <ul>
            {%- for o in c.opts %}<li{% if o.pendent %} class="tbd"{% endif %}>{{ o.n[L] }}</li>{% endfor %}
          </ul>
          {%- endif %}
        </div>
        {%- if c.destacat %}
        <div class="eso-pool">
          <span class="eso-pool__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 16c1.5 0 2.5-1 4-1s2.5 1 4 1 2.5-1 4-1 2.5 1 4 1 2.5-1 4-1"/><path d="M2 20c1.5 0 2.5-1 4-1s2.5 1 4 1 2.5-1 4-1 2.5 1 4 1 2.5-1 4-1"/><path d="M8 13V5a2 2 0 0 1 4 0M16 13V5a2 2 0 0 0-4 0M8 8h8M8 11h8"/></svg></span>
          <div class="eso-pool__body">
            <h3>{{ c.destacat.titol[L] }}</h3>
            <p>{{ c.destacat.text[L] }}</p>
            <a href="/{{ P }}{{ c.destacat.href }}">{{ c.destacat.enllac[L] }} <span aria-hidden="true">→</span></a>
          </div>
        </div>
        {%- endif %}
        {%- if c.pdf %}
        <a class="eso-doc eso-doc--row" href="{{ c.pdf }}" target="_blank" rel="noopener">
          <span>{{ c.pdfText[L] if c.pdfText else (e.curr.pdfLabel[L] ~ " " ~ c.label[L]) }} (PDF)</span>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M9 7h8v8"/></svg>
        </a>
        {%- endif %}
      </div>
      {%- if c.itineraris %}
      <div class="eso-paths">
        <div class="eso-paths__head">
          <h3>{{ e.curr.itinerarisTitol[L] }} · {{ c.label[L] }}</h3>
          <p>{{ c.itinerarisText[L] }}</p>
        </div>
        {#- Un botó per itinerari; cada itinerari mostra una taula amb una fila per tipologia.
            Franja 1 amb grup de 4 h + grups A i B → llista de les combinacions possibles. -#}
        {%- set T = {
          'itinerari': {'ca': 'Itineraris', 'es': 'Itinerarios', 'en': 'Pathways'},
          'tipologia': {'ca': 'Tipologia', 'es': 'Tipología', 'en': 'Type'},
          'materies': {'ca': 'Matèries', 'es': 'Materias', 'en': 'Subjects'},
          'combinacions': {'ca': 'Tria una d’aquestes combinacions:', 'es': 'Elige una de estas combinaciones:', 'en': 'Choose one of these combinations:'},
          'una': {'ca': 'Tria’n una:', 'es': 'Elige una:', 'en': 'Choose one:'},
          'o': {'ca': 'o', 'es': 'o', 'en': 'or'}
        } %}
        <div class="eso-ittabs" role="tablist" aria-label="{{ T.itinerari[L] }} · {{ c.label[L] }}">
          {%- for it in c.itineraris %}
          <button type="button" role="tab" id="eso-it-{{ ci }}-{{ loop.index }}" aria-controls="eso-itp-{{ ci }}-{{ loop.index }}" data-it="{{ loop.index0 }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ it.n[L] }}</button>
          {%- endfor %}
        </div>
        {%- for it in c.itineraris %}
        <div class="eso-itpanel" role="tabpanel" id="eso-itp-{{ ci }}-{{ loop.index }}" aria-labelledby="eso-it-{{ ci }}-{{ loop.index }}"{% if not loop.first %} hidden{% endif %}>
          <table class="eso-ittable">
            <thead><tr><th scope="col">{{ T.tipologia[L] }}</th><th scope="col">{{ T.materies[L] }} · {{ it.n[L] }}</th></tr></thead>
            <tbody>
              <tr>
                <th scope="row">{{ e.curr.obligatoria[L] | capitalize }} · 4 h</th>
                <td><span class="eso-ittable__ob">{{ it.obligatoria[L] }}</span></td>
              </tr>
              <tr>
                <th scope="row">{{ e.curr.modalitat[L] }} · 4 h</th>
                <td><ul class="eso-ittable__chips">{% for x in it.modalitat %}<li>{{ x[L] }}</li>{% endfor %}</ul></td>
              </tr>
              {%- for f in it.franges %}
              <tr class="eso-ittable__franja">
                <th scope="row">{{ f.titol[L] }}</th>
                <td>
                  {%- if f.grups | length == 3 %}
                  {%- set g4 = f.grups[0] %}{%- set gA = f.grups[1] %}{%- set gB = f.grups[2] %}
                  <p class="eso-comb__intro">{{ T.combinacions[L] }}</p>
                  <ol class="eso-comb">
                    {%- for x in g4.opts %}
                    <li><span class="eso-comb__mat">{{ x[L] }}</span><span class="eso-comb__h">4 h</span></li>
                    {%- endfor %}
                    {%- for a in gA.opts %}{%- for b in gB.opts %}
                    <li><span class="eso-comb__mat">{{ a[L] }} <span class="eso-comb__mes" aria-hidden="true">+</span><span class="sr-only"> i </span>{{ b[L] }}</span><span class="eso-comb__h">2 h + 2 h</span></li>
                    {%- endfor %}{%- endfor %}
                  </ol>
                  {%- else %}
                  <p class="eso-comb__intro">{{ T.una[L] }}</p>
                  <ul class="eso-ittable__chips">
                    {%- for g in f.grups %}{%- for x in g.opts %}<li>{{ x[L] }}</li>{%- endfor %}{%- endfor %}
                  </ul>
                  {%- endif %}
                </td>
              </tr>
              {%- endfor %}
            </tbody>
          </table>
        </div>
        {%- endfor %}
      </div>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>
</section>

<!-- ============ CRITERIS DE QUALIFICACIÓ ============ -->
<section id="qualificacio">
  <div class="eso-wrap">
    <h2 class="eso-ttl">{{ e.qual.titol[L] }}</h2>
    <div class="eso-row">
      <h3 class="eso-row__head">{{ e.qual.comTitol[L] }}</h3>
      <div class="eso-row__body">
        {%- if e.qual.blocs %}
        {#- Batxillerat: una caixa per nivell amb el document de criteris i el calendari de butlletins #}
        <div class="eso-qboxes">
          {%- for bl in e.qual.blocs %}
          <div class="eso-qbox">
            <h4>{{ bl.titol[L] }}</h4>
            <a class="eso-doc eso-doc--row" href="#qualificacio" data-criteris="{{ bl.nivell }}" data-nom="{{ bl.titol[L] }}"><span>{{ E.qual.criterisPdf[L] }}</span><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M9 7h8v8"/></svg></a>
            <ol class="eso-reports">
              {%- for b in bl.butlletins %}
              <li{% if b.paper %} class="eso-reports__item--paper"{% endif %}><span class="eso-reports__when">{{ b.quan[L] }}</span><span class="eso-reports__what">{{ b.que[L] }}</span><span class="eso-reports__fmt">{{ b.format[L] }}</span></li>
              {%- endfor %}
            </ol>
          </div>
          {%- endfor %}
        </div>
        {%- else %}
        <p>{{ e.qual.comText[L] }}</p>
        <div class="eso-docs">
          {%- for c in e.curr.cursos %}
          <a class="eso-doc" href="#qualificacio" data-criteris="{{ c.nivell }}" data-nom="{{ c.label[L] }}"><span class="eso-doc__title">{{ c.label[L] }}</span><span class="eso-doc__meta">{{ E.qual.criterisPdf[L] }}</span></a>
          {%- endfor %}
        </div>
        <ol class="eso-reports">
          {%- for b in e.qual.butlletins %}
          <li{% if b.paper %} class="eso-reports__item--paper"{% endif %}><span class="eso-reports__when">{{ b.quan[L] }}</span><span class="eso-reports__what">{{ b.que[L] }}</span><span class="eso-reports__fmt">{{ b.format[L] }}</span></li>
          {%- endfor %}
        </ol>
        {%- endif %}
      </div>
    </div>
    <div class="eso-row">
      <h3 class="eso-row__head">{{ e.qual.promoTitol[L] }}</h3>
      <div class="eso-row__body">
        <p>{{ e.qual.promoText[L] | safe }}</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ PROJECTES ============ -->
<section id="projectes" class="eso-band">
  <div class="eso-wrap">
    <h2 class="eso-ttl">{{ e.proj.titol[L] }}</h2>
    <ul class="eso-cards">
      {%- for p in e.proj.items %}
      <li>
        {%- if p.href %}<a class="eso-card" href="/{{ P }}{{ p.href }}">{% else %}<div class="eso-card">{% endif %}
          {%- if p.icona %}
          <div class="eso-card__img eso-card__img--icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">{{ icones[p.icona] | safe }}</svg></div>
          {%- else %}
          <div class="eso-card__img">{{ e.proj.foto[L] }}</div>
          {%- endif %}
          <div class="eso-card__body">
            <span class="eso-card__tag">{{ p.tag[L] }}</span>
            <h3>{{ p.titol[L] }}</h3>
            <p>{{ p.text[L] | safe }}</p>
          </div>
        {% if p.href %}</a>{% else %}</div>{% endif %}
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<!-- ============ ORIENTACIÓ ============ -->
<section id="orientacio">
  <div class="eso-wrap">
    <h2 class="eso-ttl">{{ e.ori.titol[L] }}</h2>
    <div class="eso-cols">
      <div>
        <svg aria-hidden="true" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#E8600C" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
        <h3>{{ E.ori.tutoriaTitol[L] }}</h3>
        <p>{{ E.ori.tutoriaText[L] | safe }}</p>
      </div>
      <div>
        <svg aria-hidden="true" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#E8600C" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/></svg>
        <h3>{{ e.ori.acadTitol[L] }}</h3>
        <p>{{ e.ori.acadText[L] | safe }}</p>
        <ul class="eso-list">
          {%- for x in e.ori.acadList %}<li>{{ x[L] }}</li>{% endfor %}
        </ul>
        {%- if e.ori.guia %}<a class="eso-more" href="#{{ e.ori.guia.id }}" data-obre-guia="{{ e.ori.guia.id }}">{{ e.ori.guia.titol[L] }} <span aria-hidden="true">↓</span></a>{% endif %}
      </div>
      {%- if e.ori.divList %}
      <div>
        <svg aria-hidden="true" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#E8600C" stroke-width="1.6"><path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z"/></svg>
        <h3>{{ e.ori.divTitol[L] }}</h3>
        <p>{{ e.ori.divText[L] | safe }}</p>
        <ul class="eso-list">
          {%- for x in e.ori.divList %}<li>{{ x[L] }}</li>{% endfor %}
        </ul>
      </div>
      {%- endif %}
    </div>

    {%- set g = e.ori.guia %}
    {%- if g %}
    {#- Bloc plegable: per defecte ocult, s'obre amb el botó (o amb l'enllaç «… ↓» / l'adreça #id) -#}
    <div class="eso-guide-toggle">
      <button type="button" class="eso-guide-toggle__btn" id="{{ g.id }}-boto" aria-expanded="false" aria-controls="{{ g.id }}">
        <span class="eso-guide-toggle__txt"><span class="eso-guide__tag">{{ g.tag[L] }}</span><span class="eso-guide-toggle__titol">{{ g.titol[L] }}</span></span>
        <span class="eso-guide-toggle__accio" data-mostra="{{ {'ca': 'Mostra la informació', 'es': 'Muestra la información', 'en': 'Show information'}[L] }}" data-amaga="{{ {'ca': 'Amaga la informació', 'es': 'Oculta la información', 'en': 'Hide information'}[L] }}">{{ {'ca': 'Mostra la informació', 'es': 'Muestra la información', 'en': 'Show information'}[L] }}</span>
        <svg class="eso-guide-toggle__chev" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </button>
    <div class="eso-guide{% if g.cols | length == 3 %} eso-guide--3{% endif %}" id="{{ g.id }}" hidden>
      <div class="eso-guide__intro">
        <span class="eso-guide__tag">{{ g.tag[L] }}</span>
        <h3>{{ g.titol[L] }}</h3>
        {%- for t in g.text %}<p>{{ t[L] | safe }}</p>{% endfor %}
      </div>
      {%- for col in g.cols %}
      <div class="eso-guide__col">
        <h4>{{ col.titol[L] }}</h4>
        {%- for t in col.paras %}<p>{{ t[L] | safe }}</p>{% endfor %}
        {%- if col.llista %}
        <ul class="eso-list">
          {%- for it in col.llista %}
          <li>{{ it.t[L] | safe }}
            {%- if it.sub %}
            <ul class="eso-guide__sub">
              {%- for sb in it.sub %}<li>{{ sb[L] | safe }}</li>{% endfor %}
            </ul>
            {%- endif %}
          </li>
          {%- endfor %}
        </ul>
        {%- endif %}
        {%- if col.links %}
        <ul class="eso-guide__links">
          {%- for r in col.links %}
          <li><a href="{{ r.href }}" target="_blank" rel="noopener"><span class="eso-guide__lt">{{ r.t[L] }}</span><span class="eso-guide__ld">{{ r.d[L] }}</span><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M9 7h8v8"/></svg></a></li>
          {%- endfor %}
        </ul>
        {%- endif %}
      </div>
      {%- endfor %}
    </div>
    </div>
    {%- endif %}
  </div>
</section>

