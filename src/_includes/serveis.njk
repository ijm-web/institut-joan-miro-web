{#- Serveis: marcatge comú (ca/es/en). Dades: src/_data/serveis.json. Estils: src/assets/css/serveis.css -#}
{%- set L = lang | default('ca') -%}
{%- set P = '' -%}
{%- if L == 'es' -%}{%- set P = 'es/' -%}{%- elif L == 'en' -%}{%- set P = 'en/' -%}{%- endif -%}
{%- set s = serveis -%}
<div class="srv-page">

<div class="qs-hero" id="qsHero">
  <img src="/assets/img/inici/inici-3-vestibul-2400.jpg" srcset="/assets/img/inici/inici-3-vestibul-1600.jpg 1600w, /assets/img/inici/inici-3-vestibul-2400.jpg 2400w" sizes="100vw" width="2400" height="900" fetchpriority="high" alt="" role="presentation">
  <div class="qs-hero__box">
    <h1><span class="qs-hero__title">{{ s.heroTitol[L] }}</span><span class="qs-hero__subtitle">{{ s.heroSubtitol[L] }}</span></h1>
  </div>
</div>

<!-- ============ INTRODUCCIÓ ============ -->
<div class="srv-wrap">
  <div class="srv-intro">
    <h2 class="srv-kicker">{{ s.kicker[L] }}</h2>
    <p class="srv-lead">{{ s.lead[L] }}</p>
  </div>
  <nav class="srv-anchors" aria-label="{{ s.anchorsLabel[L] }}">
    {%- for x in s.seccions %}
    <a href="#{{ x.id }}">{{ x.titol[L] }}</a>
    {%- endfor %}
  </nav>
</div>

{%- for x in s.seccions %}
<!-- ============ {{ x.titol.ca | upper }} ============ -->
<section id="{{ x.id }}"{% if loop.index == 2 %} class="srv-band"{% endif %}>
  <div class="srv-wrap">
    <h2 class="section-title">{{ x.titol[L] }}</h2>
    <div class="srv-grid">
      <div class="srv-main">
        <span class="srv-icon" aria-hidden="true">
          {%- if x.icona == 'cantina' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 3v7a3 3 0 0 0 3 3v8"/><path d="M7 3v6M10 3v7a3 3 0 0 1-3 3"/><path d="M17 21V3c-2.2 1.2-3.5 3.6-3.5 7v3H17"/></svg>
          {%- elif x.icona == 'taquilles' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="2.5" width="8" height="19" rx="1"/><rect x="13" y="2.5" width="8" height="19" rx="1"/><path d="M5.5 6h3M5.5 8.5h3M15.5 6h3M15.5 8.5h3"/><circle cx="9" cy="14" r=".6" fill="currentColor"/><circle cx="19" cy="14" r=".6" fill="currentColor"/></svg>
          {%- else %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="5.5" cy="17" r="3.5"/><circle cx="18.5" cy="17" r="3.5"/><path d="M5.5 17l4-8h6l3 8M9.5 9L8 6H6M15.5 9l-3 8H5.5"/><path d="M14 6h2.5"/></svg>
          {%- endif %}
        </span>
        <p class="srv-text">{{ x.intro[L] }}</p>
        <div class="srv-note">
          <h3>{{ s.tenirEnCompte[L] }} · {{ x.notaTitol[L] }}</h3>
          <p>{{ x.nota[L] }}</p>
        </div>
      </div>
      <div class="srv-side">
        <div class="srv-card">
          <h3>{{ s.comFunciona[L] }}</h3>
          <ul class="srv-list">
            {%- for pt in x.punts %}
            <li>{{ pt[L] }}</li>
            {%- endfor %}
          </ul>
        </div>
        <div class="srv-card srv-card--how">
          <h3>{{ s.solTitol[L] }}</h3>
          <p>{{ x.sol[L] }}</p>
        </div>
      </div>
    </div>
  </div>
</section>
{%- endfor %}

<!-- ============ FRANJA FINAL ============ -->
<section class="srv-cta">
  <div class="srv-cta__inner">
    <div>
      <p class="srv-cta__title">{{ s.cta.titol[L] }}</p>
      <p class="srv-cta__text">{{ s.cta.text[L] }}</p>
    </div>
    <a class="btn btn--light" href="/{{ P }}contacte.html">{{ s.cta.boto[L] }}</a>
  </div>
</section>

</div>
