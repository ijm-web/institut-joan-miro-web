{#- Secretaria › Recollida de títols / Sol·licitud de títols / Beques i ajuts (ca/es/en).
    Cada pàgina defineix `tramit` al front matter: "recollida", "sollicitud" o "beques".
    Dades: src/_data/secretariaTramits.json · Estils: src/assets/css/secretaria-tramit.css
    Les dades pendents porten la classe `tbd` (fons groc). -#}
{%- set L = lang | default('ca') -%}
{%- set P = '' -%}
{%- if L == 'es' -%}{%- set P = 'es/' -%}{%- elif L == 'en' -%}{%- set P = 'en/' -%}{%- endif -%}
{%- set D = secretariaTramits -%}
{%- set s = D[tramit] -%}
{%- set nw = D.obreFinestra[L] -%}
{%- macro ext() -%}<svg class="st-ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>{%- endmacro -%}
{%- macro icona(nom) -%}
  {%- if nom == 'titol' -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3L2 8l10 5 10-5-10-5z"/><path d="M6 10.2V15c0 1.7 2.7 3 6 3s6-1.3 6-3v-4.8"/><path d="M22 8v6"/></svg>
  {%- elif nom == 'sollicitud' -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/><path d="M8.5 10.5l2.2 2.2 4.8-4.8"/></svg>
  {%- elif nom == 'beques' -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M15 9.2c-.6-1-1.7-1.6-3-1.6-1.7 0-3 .9-3 2.2 0 3 6 1.5 6 4.4 0 1.3-1.3 2.2-3 2.2-1.4 0-2.6-.7-3.1-1.7"/><path d="M12 6v1.6M12 16.4V18"/></svg>
  {%- else -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg>
  {%- endif -%}
{%- endmacro -%}
<div class="st-page">

<div class="qs-hero" id="qsHero">
  <img src="/assets/img/inici/inici-3-vestibul-2400.jpg" srcset="/assets/img/inici/inici-3-vestibul-1600.jpg 1600w, /assets/img/inici/inici-3-vestibul-2400.jpg 2400w" sizes="100vw" width="2400" height="900" fetchpriority="high" alt="" role="presentation">
  <div class="qs-hero__box">
    <h1><span class="qs-hero__title">{{ D.heroTitol[L] }}</span><span class="qs-hero__subtitle">{{ s.subtitol[L] }}</span></h1>
  </div>
</div>

{%- if tramit == 'recollida' or (tramit == 'sollicitud' and not s.docInfo.href) %}
<p class="st-pending-note">{{ D.pendent[L] | safe }}</p>
{%- endif %}

<!-- ============ INTRODUCCIÓ ============ -->
<div class="st-wrap">
  <div class="st-intro">
    <h2 class="st-kicker">{{ s.kicker[L] }}</h2>
    <p class="st-lead">{{ s.lead[L] | replace('{P}', P) | safe }}</p>
  </div>

{%- if tramit == 'recollida' %}
<!-- ============ RECOLLIDA DE TÍTOLS ============ -->
  <div class="st-grid">
    <div class="st-col">
      <h3 class="st-h3">{{ s.disponiblesTitol[L] }}</h3>
      <ul class="st-titols">
        {%- for x in s.disponibles %}
        <li>
          <span class="st-icon st-icon--sm" aria-hidden="true">{{ icona('titol') | safe }}</span>
          <div><strong>{{ x.nom[L] }}</strong><span>{{ x.rang[L] | safe }}</span></div>
        </li>
        {%- endfor %}
      </ul>
      <div class="st-card st-card--blue">
        <h3>{{ s.onTitol[L] }}</h3>
        <p>{{ s.on[L] | replace('{P}', P) | safe }}</p>
      </div>
    </div>
    <div class="st-col">
      <div class="st-card">
        <h3>{{ s.personaTitol[L] }}</h3>
        <ul class="st-list">
          {%- for pt in s.persona %}<li>{{ pt[L] }}</li>{% endfor %}
        </ul>
      </div>
      <div class="st-card">
        <h3>{{ s.autoritzatTitol[L] }}</h3>
        <p class="st-card__intro">{{ s.autoritzatIntro[L] }}</p>
        <ul class="st-list">
          {%- for pt in s.autoritzat %}<li>{{ pt[L] }}</li>{% endfor %}
        </ul>
      </div>
    </div>
  </div>
  <p class="st-note">{{ s.nota[L] | replace('{P}', P) | safe }}</p>

{%- elif tramit == 'sollicitud' %}
<!-- ============ SOL·LICITUD DE TÍTOLS ============ -->
  <p class="st-note">{{ s.esoNota[L] | safe }}</p>

  <h3 class="section-title">{{ s.passosTitol[L] }}</h3>
  <ol class="st-steps">
    {%- for p in s.passos %}
    <li class="st-step">
      <span class="st-step__num" aria-hidden="true">{{ loop.index }}</span>
      <h4>{{ p.t[L] }}</h4>
      <p>{{ p.d[L] | replace('{P}', P) | safe }}</p>
    </li>
    {%- endfor %}
  </ol>

  <h3 class="section-title">{{ s.enllacosTitol[L] }}</h3>
  <div class="st-links">
    {%- if s.docInfo.href %}
    <a class="st-link" href="{{ s.docInfo.href }}" target="_blank" rel="noopener">
      <span class="st-icon" aria-hidden="true">{{ icona('certificat') | safe }}</span>
      <span class="st-link__body"><strong>{{ s.docInfo.titol[L] }}</strong><span>{{ s.docInfo.text[L] }}</span></span>
      {{ ext() | safe }}<span class="visually-hidden"> {{ nw }}</span>
    </a>
    {%- else %}
    <div class="st-link st-link--pending" aria-disabled="true">
      <span class="st-icon" aria-hidden="true">{{ icona('certificat') | safe }}</span>
      <span class="st-link__body"><strong>{{ s.docInfo.titol[L] }}</strong><span>{{ s.docInfo.text[L] }}</span><span class="tbd st-link__tbd">{{ s.docInfo.pendent[L] }}</span></span>
    </div>
    {%- endif %}
    <a class="st-link" href="{{ s.webGencat.href }}" target="_blank" rel="noopener">
      <span class="st-icon" aria-hidden="true">{{ icona('sollicitud') | safe }}</span>
      <span class="st-link__body"><strong>{{ s.webGencat.titol[L] }}</strong><span>{{ s.webGencat.text[L] }}</span></span>
      {{ ext() | safe }}<span class="visually-hidden"> {{ nw }}</span>
    </a>
  </div>
  <p class="st-note">{{ s.nota[L] | replace('{P}', P) | safe }}</p>

{%- elif tramit == 'beques' %}
<!-- ============ BEQUES I AJUTS ============ -->
  <div class="st-beques">
    {%- for b in s.enllacos %}
    <article class="st-beca">
      <span class="st-icon" aria-hidden="true">{{ icona('beques') | safe }}</span>
      <p class="st-beca__ent">{{ b.ent[L] }}</p>
      <h3>{{ b.titol[L] }}</h3>
      <p class="st-beca__text">{{ b.text[L] }}</p>
      <a class="btn" href="{{ b.href }}" target="_blank" rel="noopener">{{ b.boto[L] }} {{ ext() | safe }}<span class="visually-hidden"> {{ nw }}</span></a>
    </article>
    {%- endfor %}
  </div>
  <p class="st-note">{{ s.nota[L] | replace('{P}', P) | safe }}</p>
{%- endif %}
</div>

<!-- ============ ALTRES TRÀMITS ============ -->
<section class="st-band">
  <div class="st-wrap">
    <h2 class="section-title">{{ D.altresTitol[L] }}</h2>
    <div class="st-others">
      {%- for x in D.tramits %}{% if x.id != tramit %}
      <a class="st-other" href="{{ x.href | replace('{P}', P) }}"{% if x.extern %} target="_blank" rel="noopener"{% endif %}>
        <span class="st-icon" aria-hidden="true">{{ icona(x.icona) | safe }}</span>
        <strong>{{ x.titol[L] }}</strong>
        <span>{{ x.text[L] }}</span>
        {%- if x.extern %}<span class="visually-hidden"> {{ nw }}</span>{% endif %}
      </a>
      {%- endif %}{% endfor %}
    </div>
  </div>
</section>

</div>
