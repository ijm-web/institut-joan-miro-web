{#- Àrea privada del professorat. Aquesta pàgina només conté el formulari d'entrada:
    el contingut el dona la funció /api/programacions/contingut si la sessió és vàlida.
    Accés: compte @institutjoanmiro.cat que consti a la pestanya «departaments» del full de dades.
    Funcions: netlify/functions/programacions-*.mjs · Variables: vegeu LEGIR_PROGRAMACIONS.md -#}
<div class="qs-hero" id="qsHero">
  <img src="/assets/img/inici/inici-3-vestibul-2400.jpg" srcset="/assets/img/inici/inici-3-vestibul-1600.jpg 1600w, /assets/img/inici/inici-3-vestibul-2400.jpg 2400w" sizes="100vw" width="2400" height="900" fetchpriority="high" alt="" role="presentation">
  <div class="qs-hero__box">
    <h1><span class="qs-hero__title">Professorat</span><span class="qs-hero__subtitle">Programacions</span></h1>
  </div>
</div>

<section class="uc prog">
  <div class="uc__inner">

    <div class="prog-card" id="progLogin" hidden>
      <svg class="prog-card__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15.5" r="1.5"/></svg>
      <p class="uc__kicker">Àrea privada</p>
      <h2 class="uc__title">Accés del professorat</h2>
      <p class="uc__text">Entreu amb el vostre compte <strong>@institutjoanmiro.cat</strong>. Només hi tenen accés les persones autoritzades dels departaments.</p>
      <div id="progGoogle" class="prog-card__btn"></div>
      <p class="prog-msg" id="progMsg" role="alert" hidden></p>
    </div>

    <div id="progContingut" hidden></div>
    <div class="prog-user" id="progUser" hidden>
      <span id="progEmail"></span>
      <button type="button" class="btn btn--secondary" id="progSortir">Surt</button>
    </div>

    <p class="uc__text" id="progCarregant">Comprovant l’accés…</p>
  </div>
</section>

{% raw %}
<script>
(function(){
  var $ = function(id){ return document.getElementById(id); };
  var MISSATGES = {
    domini_no_permes: 'Cal entrar amb un compte @institutjoanmiro.cat.',
    email_sense_departament: 'Aquest compte no té accés a les programacions. Si creieu que és un error, parleu amb la coordinació pedagògica.',
    sense_acces: 'Aquest compte no té accés a les programacions.',
    acces_google_desactivat: 'L’accés amb Google està desactivat temporalment.',
    google_token_invalid: 'No s’ha pogut validar l’inici de sessió amb Google. Torneu-ho a provar.',
    google_no_configurat: 'L’accés encara no està configurat.',
    error_servidor: 'Hi ha hagut un error. Torneu-ho a provar d’aquí a una estona.'
  };
  function missatge(codi){ var m = $('progMsg'); m.textContent = MISSATGES[codi] || MISSATGES.error_servidor; m.hidden = false; }

  function mostraContingut(d){
    $('progCarregant').hidden = true;
    $('progLogin').hidden = true;
    $('progContingut').innerHTML = d.html;
    $('progContingut').hidden = false;
    $('progEmail').textContent = d.email;
    $('progUser').hidden = false;
  }

  function mostraLogin(){
    $('progCarregant').hidden = true;
    $('progLogin').hidden = false;
    fetch('/api/programacions/config').then(function(r){ return r.json(); }).then(function(c){
      if (!c.ok || !c.google_client_id){ missatge('google_no_configurat'); return; }
      var s = document.createElement('script');
      s.src = 'https://accounts.google.com/gsi/client'; s.async = true;
      s.onload = function(){
        google.accounts.id.initialize({ client_id: c.google_client_id, callback: entra, hd: c.domini, ux_mode: 'popup' });
        google.accounts.id.renderButton($('progGoogle'), { theme: 'outline', size: 'large', text: 'signin_with', locale: 'ca' });
      };
      document.head.appendChild(s);
    }).catch(function(){ missatge('error_servidor'); });
  }

  function entra(resp){
    $('progMsg').hidden = true;
    fetch('/api/programacions/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ credential: resp.credential }), credentials: 'same-origin' })
      .then(function(r){ return r.json(); })
      .then(function(d){ if (d.ok) carrega(); else missatge(d.error); })
      .catch(function(){ missatge('error_servidor'); });
  }

  function carrega(){
    fetch('/api/programacions/contingut', { credentials: 'same-origin', cache: 'no-store' })
      .then(function(r){ return r.ok ? r.json() : null; })
      .then(function(d){ if (d && d.ok) mostraContingut(d); else mostraLogin(); })
      .catch(mostraLogin);
  }

  $('progSortir').addEventListener('click', function(){
    fetch('/api/programacions/sortir', { method: 'POST', credentials: 'same-origin' }).then(function(){
      if (window.google && google.accounts) google.accounts.id.disableAutoSelect();
      location.reload();
    });
  });

  carrega();
})();
</script>
{% endraw %}
